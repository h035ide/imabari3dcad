OSHIP_HELP_FILES\\\\about_annotation_styles_list_dialog.html'), EntityNode(label='HelpSection', embedding=None, properties={'section_id': '948fca157e8e5cee99d571163057daa7a31b2157', 'document_id': 'C:\\\\Users\\\\akiro\\\\workfolder\\\\imabari3dcad\\\\evoship\\\\EVOSHIP_HELP_FILES\\\\about_annotation_styles_list_dialog.html', 'source_path': 'C:\\\\Users\\\\akiro\\\\workfolder\\\\imabari3dcad\\\\evoship\\\\EVOSHIP_HELP_FILES\\\\about_annotation_styles_list_dialog.html', 'title': '注記・寸法スタイル設定', 'section_heading': '注記スタイルの作成', 'section_level': 3, 'section_index': 2, 'last_modified': '2025-07-08T01:02:52+00:00', 'extracted_at': '2025-11-04T06:48:51+00:00', 'data_source': 'EVOSHIP_HELP_FILES'}, name='948fca157e8e5cee99d571163057daa7a31b2157'), ChunkNode(label='HelpChunk', embedding=None, properties={'chunk_id': 'e4da690c-d634-4200-9be8-f1e67bc22dd5', 'document_id': 'C:\\\\Users\\\\akiro\\\\workfolder\\\\imabari3dcad\\\\evoship\\\\EVOSHIP_HELP_FILES\\\\about_annotation_styles_list_dialog.html', 'section_id': '948fca157e8e5cee99d571163057daa7a31b2157', 'source_path': 'C:\\\\Users\\\\akiro\\\\workfolder\\\\imabari3dcad\\\\evoship\\\\EVOSHIP_HELP_FILES\\\\about_annotation_styles_list_dialog.html', 'title': '注記・寸法スタイル設定', 'section_heading': '注記スタイルの作成', 'section_level': 3, 'section_index': 2, 'last_modified': '2025-07-08T01:02:52+00:00', 'extracted_at': '2025-11-04T06:48:51+00:00', 'chunk_index': 0, 'text_length': 223, 'start_char_idx': 0, 'end_char_idx': 223, 'data_source': 'EVOSHIP_HELP_FILES'}, text='注記スタイルの作成\\n\\n左側のスタイル一覧が表示されている欄でコンテキストメニューを表示し、「スタイル設定の追加」をクリックします。また、「モデルのスタイル設定を追加」をクリックすると、いま開いているモデル内のスケッチや図面が保持している注記スタイルがすべてスタイル一覧に追加されます。\\nまた、既存のスタイルを元にして新しくスタイルを作りたい場合は、スタイルを選択してコンテキストメニューを表示し、「スタイル設定（コピー）の追加」をクリックします。', id_='e4da690c-d634-4200-9be8-f1e67bc22dd5')]\nrelations: [Relation(label='HAS_SECTION', source_id='C:\\\\Users\\\\akiro\\\\workfolder\\\\imabari3dcad\\\\evoship\\\\EVOSHIP_HELP_FILES\\\\about_annotation_styles_list_dialog.html', target_id='948fca157e8e5cee99d571163057daa7a31b2157', properties={'data_source': 'EVOSHIP_HELP_FILES'}), Relation(label='HAS_CHUNK', source_id='C:\\\\Users\\\\akiro\\\\workfolder\\\\imabari3dcad\\\\evoship\\\\EVOSHIP_HELP_FILES\\\\about_annotation_styles_list_dialog.html', target_id='e4da690c-d634-4200-9be8-f1e67bc22dd5', properties={'data_source': 'EVOSHIP_HELP_FILES', 'section_id': '948fca157e8e5cee99d571163057daa7a31b2157', 'chunk_index': 0}), Relation(label='HAS_CHUNK', source_id='948fca157e8e5cee99d571163057daa7a31b2157', target_id='e4da690c-d634-4200-9be8-f1e67bc22dd5', properties={'data_source': 'EVOSHIP_HELP_FILES', 'chunk_index': 0})]\n\n注記スタイルの作成\n\n左側のスタイル一覧が表示されている欄でコンテキストメニューを表示し、「スタイル設定の追加」をクリックします。また、「モデルのスタイル設定を追加」をクリックすると、いま開いているモデル内のスケッチや図面が保持している注記スタイルがすべてスタイル一覧に追加されます。\nまた、既存のスタイルを元にして新しくスタイルを作りたい場合は、スタイルを選択してコンテキストメニューを表示し、「スタイル設定（コピー）の追加」をクリックします。\nTriplets:\n"}], 'model': 'gpt-5-nano', 'stream': False, 'temperature': 1.0}}
