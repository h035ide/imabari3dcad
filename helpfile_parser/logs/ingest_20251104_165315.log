EVOSHIP_HELP_FILES\\\\about_annotation_styles_list_dialog.html'), EntityNode(label='HelpSection', embedding=None, properties={'section_id': '786c297220afb12a8df819d022353fa285b84116', 'document_id': 'C:\\\\Users\\\\akiro\\\\workfolder\\\\imabari3dcad\\\\evoship\\\\EVOSHIP_HELP_FILES\\\\about_annotation_styles_list_dialog.html', 'source_path': 'C:\\\\Users\\\\akiro\\\\workfolder\\\\imabari3dcad\\\\evoship\\\\EVOSHIP_HELP_FILES\\\\about_annotation_styles_list_dialog.html', 'title': '注記・寸法スタイル設定', 'section_heading': '注記・寸法スタイル設定', 'section_level': 2, 'section_index': 0, 'last_modified': '2025-07-08T01:02:52+00:00', 'extracted_at': '2025-11-04T07:53:17+00:00', 'data_source': 'EVOSHIP_HELP_FILES'}, name='786c297220afb12a8df819d022353fa285b84116'), ChunkNode(label='HelpChunk', embedding=None, properties={'chunk_id': '0fda72e2-604b-4f1a-8669-b5773fe755e7', 'document_id': 'C:\\\\Users\\\\akiro\\\\workfolder\\\\imabari3dcad\\\\evoship\\\\EVOSHIP_HELP_FILES\\\\about_annotation_styles_list_dialog.html', 'section_id': '786c297220afb12a8df819d022353fa285b84116', 'source_path': 'C:\\\\Users\\\\akiro\\\\workfolder\\\\imabari3dcad\\\\evoship\\\\EVOSHIP_HELP_FILES\\\\about_annotation_styles_list_dialog.html', 'title': '注記・寸法スタイル設定', 'section_heading': '注記・寸法スタイル設定', 'section_level': 2, 'section_index': 0, 'last_modified': '2025-07-08T01:02:52+00:00', 'extracted_at': '2025-11-04T07:53:17+00:00', 'chunk_index': 0, 'text_length': 570, 'start_char_idx': 0, 'end_char_idx': 570, 'data_source': 'EVOSHIP_HELP_FILES'}, text='注記・寸法スタイル設定\\n\\n注記や寸法の各種パラメータは、要素ひとつひとつに設定することもできますし、スケッチや図面にまとめてパラメータを設定しておいて、注記や寸法はみずからが属するスケッチに設定しておいたパラメータを参照するようにもできます。この「まとめて設定しておくパラメータ」のことを注記スタイルといいます。 注記スタイルの管理 「注記・寸法スタイル設定」ウィンドウで作成した注記スタイルは、システム設定として保存されます。注記スタイルをスケッチや図面に適用すると、スケッチや図面はそのスタイルのコピーを保持します。スケッチや図面にスタイルを適用してから、「注記・寸法スタイル設定」ウィンドウでそのスタイルを編集しても、スケッチや図面が保持している「コピーされた」スタイルは変更されません。 注記スタイルの作成 左側のスタイル一覧が表示されている欄でコンテキストメニューを表示し、「スタイル設定の追加」をクリックします。また、「モデルのスタイル設定を追加」をクリックすると、いま開いているモデル内のスケッチや図面が保持している注記スタイルがすべてスタイル一覧に追加されます。 また、既存のスタイルを元にして新しくスタイルを作りたい場合は、スタイルを選択してコンテキストメニューを表示し、「スタイル設定（コピー）の追加」をクリックします。', id_='0fda72e2-604b-4f1a-8669-b5773fe755e7')]\nrelations: [Relation(label='HAS_SECTION', source_id='C:\\\\Users\\\\akiro\\\\workfolder\\\\imabari3dcad\\\\evoship\\\\EVOSHIP_HELP_FILES\\\\about_annotation_styles_list_dialog.html', target_id='786c297220afb12a8df819d022353fa285b84116', properties={'data_source': 'EVOSHIP_HELP_FILES'}), Relation(label='HAS_CHUNK', source_id='C:\\\\Users\\\\akiro\\\\workfolder\\\\imabari3dcad\\\\evoship\\\\EVOSHIP_HELP_FILES\\\\about_annotation_styles_list_dialog.html', target_id='0fda72e2-604b-4f1a-8669-b5773fe755e7', properties={'data_source': 'EVOSHIP_HELP_FILES', 'section_id': '786c297220afb12a8df819d022353fa285b84116', 'chunk_index': 0}), Relation(label='HAS_CHUNK', source_id='786c297220afb12a8df819d022353fa285b84116', target_id='0fda72e2-604b-4f1a-8669-b5773fe755e7', properties={'data_source': 'EVOSHIP_HELP_FILES', 'chunk_index': 0})]\n\n注記・寸法スタイル設定\n\n注記や寸法の各種パラメータは、要素ひとつひとつに設定することもできますし、スケッチや図面にまとめてパラメータを設定しておいて、注記や寸法はみずからが属するスケッチに設定しておいたパラメータを参照するようにもできます。この「まとめて設定しておくパラメータ」のことを注記スタイルといいます。 注記スタイルの管理 「注記・寸法スタイル設定」ウィンドウで作成した注記スタイルは、システム設定として保存されます。注記スタイルをスケッチや図面に適用すると、スケッチや図面はそのスタイルのコピーを保持します。スケッチや図面にスタイルを適用してから、「注記・寸法スタイル設定」ウィンドウでそのスタイルを編集しても、スケッチや図面が保持している「コピーされた」スタイルは変更されません。 注記スタイルの作成 左側のスタイル一覧が表示されている欄でコンテキストメニューを表示し、「スタイル設定の追加」をクリックします。また、「モデルのスタイル設定を追加」をクリックすると、いま開いているモデル内のスケッチや図面が保持している注記スタイルがすべてスタイル一覧に追加されます。 また、既存のスタイルを元にして新しくスタイルを作りたい場合は、スタイルを選択してコンテキストメニューを表示し、「スタイル設定（コピー）の追加」をクリックします。\nTriplets:\n"}], 'model': 'gpt-5-nano', 'stream': False, 'temperature': 1.0}}
