7-08T01:02:52+00:00", "extracted_at": "2025-11-04T08:53:15+00:00", "data_source": "EVOSHIP_HELP_FILES", "chunk_id": "c194c129-2349-43a8-a1d0-5e1c071fea07", "chunk_index": 0, "text_length": 250, "start_char_idx": 0, "end_char_idx": 250}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "20282e22440d39595fb32550c039519844363c95", "node_type": "4", "metadata": {"document_id": "C:\\\\Users\\\\akiro\\\\workfolder\\\\imabari3dcad\\\\evoship\\\\EVOSHIP_HELP_FILES\\\\about_annotation_styles_list_dialog.html", "source_path": "C:\\\\Users\\\\akiro\\\\workfolder\\\\imabari3dcad\\\\evoship\\\\EVOSHIP_HELP_FILES\\\\about_annotation_styles_list_dialog.html", "section_id": "20282e22440d39595fb32550c039519844363c95", "title": "\\u6ce8\\u8a18\\u30fb\\u5bf8\\u6cd5\\u30b9\\u30bf\\u30a4\\u30eb\\u8a2d\\u5b9a", "section_heading": "\\u9069\\u7528\\u305a\\u307f\\u30b9\\u30bf\\u30a4\\u30eb\\u306e\\u66f4\\u65b0", "section_level": 3, "section_index": 3, "last_modified": "2025-07-08T01:02:52+00:00", "extracted_at": "2025-11-04T08:53:15+00:00", "data_source": "EVOSHIP_HELP_FILES"}, "hash": "ca40a580f61dc92f54da2303a925671778cd3cf483f5a0cf0237cf675b5cbea0", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\\n", "text": "", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 250, "metadata_seperator": "\\n", "text_template": "{metadata_str}\\n\\n{content}", "class_name": "TextNode"}', '_node_type': 'TextNode', 'doc_id': '20282e22440d39595fb32550c039519844363c95', 'ref_doc_id': '20282e22440d39595fb32550c039519844363c95'}, 'text': '適用ずみスタイルの更新\n\nウィンドウ右下の「モデルの更新」ボタンをクリックすると、「注記・寸法スタイル設定」ウィンドウで管理している（システム設定として保存されている）各スタイルについて、スケッチや図面に適用ずみのスタイルで同名のものがあると、その適用ずみスタイルをシステム設定のスタイルで上書きします。\nスタイル一覧に同名のスタイルが複数存在すると、それらのうちひとつだけが適用ずみスタイルの上書きに使われて、残りは無視されてしまいます。同名のスタイルを作るのはできるだけ避けるようにしてください。', 'id_': 'c194c129-2349-43a8-a1d0-5e1c071fea07', 'id': 'c194c129-2349-43a8-a1d0-5e1c071fea07'}, {'label': 