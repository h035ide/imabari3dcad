いるモデル内のスケッチや図面が保持している注記スタイルがすべてスタイル一覧に追加されます。\nまた、既存のスタイルを元にして新しくスタイルを作りたい場合は、スタイルを選択してコンテキストメニューを表示し、「スタイル設定（コピー）の追加」をクリックします。', 'id_': '35cf5210-d2a8-4bf5-a364-6fcb7b8ab985', 'id': '35cf5210-d2a8-4bf5-a364-6fcb7b8ab985'}, {'label': 'text_chunk', 'embedding': [-0.01054701954126358, 0.012382511980831623, 0.010631734505295753, -0.022294169291853905, -0.008238535374403, 0.01589818485081196, -0.012975516729056835, -0.0151357501745224, 0.0025149770081043243, -0.017663080245256424, 0.002792065730318427, -0.008838600479066372, -0.001976683735847473, 0.0031468099914491177, -0.041227973997592926, 0.016604144126176834, 0.01134475227445364, -0.014726294204592705, 0.011323573999106884, -0.01620880700647831, 0.00048799379146657884, 0.030638597905635834, -0.02753238007426262, -0.014097990468144417, -0.010370530188083649, 0.026346370577812195, 0.034959062933921814, -0.027094686403870583, -0.004133387003093958, -0.011005892418324947, 0.015446371398866177, 0.007638470735400915, -0.00361450738273561, -0.037133414298295975, 0.008160879835486412, 0.007504338398575783, -0.002592632547020912, -0.031768132001161575, 0.023296630010008812, -0.013850905001163483, -0.005135847721248865, -0.021023442968726158, -0.0037027522921562195, -0.00032099048257805407, 0.0007346380152739584, 0.003192697186022997, 0.005312337540090084, 0.016279403120279312, -0.015742873772978783, 0.028323054313659668, 0.026544038206338882, 0.035552069544792175, -0.0394207201898098, -0.021701162680983543, 0.017719557508826256, 0.00022745098976884037, 0.004352233838289976, 0.03538263961672783, -0.00865505076944828, 0.0037027522921562195, 0.001710184384137392, 0.024256734177470207, -0.015065154060721397, -0.01975271850824356, -0.027955954894423485, -0.013977977447211742, -0.0048111071810126305, -0.004468717146664858, -0.0055806017480790615, 0.01567227765917778, 0.03645569458603859, 0.023155437782406807, -0.004705213475972414, 0.0034062496852129698, 0.025033287703990936, -0.020741060376167297, -0.0016087029362097383, -0.0133